# Equity Bank — variables d'environnement
# Copier vers .env en local, et renseigner TOUTES ces clés sur Vercel (Production).

# URL publique de cette app (prod: https://equity.ekonzo.site)
NEXT_PUBLIC_APP_URL=

# Neon PostgreSQL (obligatoire — sans ça Prisma tente wss://localhost)
DATABASE_URL=
DIRECT_URL=

# Interop ekonzo (copier depuis /bank/integration — API publique www.ekonzo.site)
EKONZO_CLIENT_ID=
EKONZO_CLIENT_SECRET=
EKONZO_BANK_CODE=BANK_001
EKONZO_API_URL=https://www.ekonzo.site

# Taux interne multi-devises (optionnel, défaut 2850)
USD_CDF_RATE=2850

# Session agents (obligatoire, secret long aléatoire)
SESSION_SECRET=

# Seed local uniquement
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# KYC (AWS Textract) — mêmes clés que ekonzo
KYC_PROVIDER=aws
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OTP e-mail (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
